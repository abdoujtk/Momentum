<Page x:Class="Momentum.Desktop.Views.HabitDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:contracts="using:Momentum.Contracts.DTOs"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header with Back Button -->
        <Grid Grid.Row="0"
              Padding="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    Background="Transparent"
                    Padding="8">
                <FontIcon Glyph="&#xE72B;"
                          FontSize="16" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="Habit Details"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24"
                        Spacing="24">

                <!-- Loading & Error -->
                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Width="32"
                              Height="32"
                              HorizontalAlignment="Left" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                         Severity="Error"
                         Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                         IsClosable="False" />

                <!-- Details Section (Only visible when data is loaded) -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasDetails, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.Details.Habit.Title, Mode=OneWay, FallbackValue=''}"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Details.Habit.CategoryName, Mode=OneWay, FallbackValue=''}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Stats Cards -->
                <Grid ColumnSpacing="12"
                      Visibility="{x:Bind ViewModel.HasDetails, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Details.CurrentStreak, Mode=OneWay, FallbackValue=0}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="Orange" />
                            <TextBlock Text="Current Streak"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Details.BestStreak, Mode=OneWay, FallbackValue=0}"
                                       FontSize="32"
                                       FontWeight="Bold" />
                            <TextBlock Text="Best Streak"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Details.TotalCompletedDays, Mode=OneWay, FallbackValue=0}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="Green" />
                            <TextBlock Text="Total Completed"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- History List -->
                <StackPanel Spacing="8"
                            Visibility="{x:Bind ViewModel.HasDetails, Mode=OneWay}">
                    <TextBlock Text="Recent History (Last 30 Days)"
                               Style="{StaticResource SubtitleTextBlockStyle}" />

                    <ListView ItemsSource="{x:Bind ViewModel.RecentCheckIns, Mode=OneWay}"
                              SelectionMode="None"
                              MaxHeight="400">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="contracts:CheckInDto">
                                <Grid Padding="12"
                                      ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0"
                                              Glyph="{x:Bind IsCompleted, Converter={StaticResource BoolToCheckmarkConverter}}"
                                              Foreground="{x:Bind IsCompleted, Converter={StaticResource BoolToColorConverter}}"
                                              FontSize="16"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1"
                                                Spacing="2">
                                        <TextBlock Text="{x:Bind CheckInDate}"
                                                   Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Note}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Visibility="{x:Bind Note, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind ActualValue, FallbackValue=''}"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>